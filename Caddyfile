{$SITE_DOMAIN} {
	encode zstd gzip
	@miniapp path /miniapp /miniapp/*
	handle @miniapp {
		reverse_proxy miniapp:3001
	}
	handle {
		reverse_proxy web:3000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@owner path /owner /owner/*
	header @owner Content-Security-Policy "frame-ancestors 'none'"
}
