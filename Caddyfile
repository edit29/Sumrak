{$SITE_DOMAIN} {
	encode zstd gzip
	@miniapp path /miniapp /miniapp/*
	handle @miniapp {
		reverse_proxy miniapp:3001
	}
	handle {
		reverse_proxy web:3000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-UnUEmnfgoAvrlShrdsJO1dviXYCFad8MHg6PXGbsXyg=' 'sha256-OBTN3RiyCV4Bq7dfqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-ZeEV+Sxjwp1u0416RC10lWhzP+67Ziu1qFtj1W9YEVc=' 'sha256-QKZa1pHgLw1htyrtia99Ge8/oSMRTbLbTgOHX7BXo5E=' 'sha256-6eloOs/wegtfs/rsCS5iyxmRv7ysIrUvVmFO/13wfbI=' 'sha256-ASBv0wsDUAxJX0r+k4Ov7tHa2KOxYBjjgj+gxFvELZs=' 'sha256-Qz64raOnaX9yQqboIToS0jPXVCYJfUNtK8F1s6UawoM=' 'sha256-oY/645YNNiIz2j02YqDv54lUER2HBhWJaYCXOjs1SOk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self';"
		-Server
	}
	@owner path /owner /owner/*
	header @owner Content-Security-Policy "frame-ancestors 'none'"
}
