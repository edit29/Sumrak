# Copy to .env for local API development; the API checks this folder and its parent.
# Use managed secrets and credentials in production.
DATABASE_URL=postgres://postgres:dev@localhost:5432/sumrak
ALLOWED_ORIGIN=http://localhost:3000
OWNER_PASSWORD=replace-with-a-unique-secret
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
TELEGRAM_MINI_APP_ORIGIN=http://localhost:3001
# Вход в кабинет из Telegram без пароля. Через запятую, без пробелов. Пусто = вход только по паролю.
# Username закрепляется за числовым ID при первом входе; надёжнее указывать числовые ID (бот @userinfobot).
OWNER_TELEGRAM_USERNAMES=
OWNER_TELEGRAM_IDS=
